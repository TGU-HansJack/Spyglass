<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(VINTAGE_STORY)/Lib/OpenTK*.dll" />
    <None Include="$(VINTAGE_STORY)/Lib/glfw3.dll" CopyToOutputDirectory="PreserveNewest" Link="glfw3.dll" />
    <Compile Include="../../spyglass/src/Client/AtmosphericOpticsModel.cs" Link="AtmosphericOpticsModel.cs" />
    <Compile Include="../../spyglass/src/Client/OpticsRenderState.cs" Link="OpticsRenderState.cs" />
    <Compile Include="../../spyglass/src/Client/LensRainModel.cs" Link="LensRainModel.cs" />
    <Compile Include="../../spyglass/src/Client/LensRainSurface.cs" Link="LensRainSurface.cs" />
    <None Include="../../spyglass/assets/spyglassfork/shaders/*" CopyToOutputDirectory="PreserveNewest" Link="shaders/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
